# Database
# Neon example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL=""

# Optional Prisma direct URL.
# Keep empty unless your provider gives you a separate direct connection string.
DIRECT_URL=""

# Groq AI
# Used by lib/ai/groq.ts. You can leave it empty until the AI console is implemented.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini AI (optional, primary AI provider)
# Get free key at https://aistudio.google.com/apikey
# Gemini is tried first; Groq is used as fallback.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Email
# Used later for purchase order emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="compras@ztocky.app"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Ztocky"

# Web Push (PWA) — VAPID keys
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Auth0 (Google login)
# Create app in https://manage.auth0.com and configure Google social login
# Set callback URL to https://tudominio.com/auth/callback
# Set logout URL to https://tudominio.com/
AUTH0_DOMAIN=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""

# Optional bootstrap admin for prisma db seed.
# If these are empty, the first registered user becomes SUPER_ADMIN automatically.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Ztocky Admin"
