generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========== USUARIOS / WORKSPACES ==========
model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  cuitCuil      String?    @map("cuit_cuil")
  passwordHash  String?    @map("password_hash")
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @map("last_login_at")
  supportNotes  String?    @map("support_notes")
  emailVerified Boolean    @default(false) @map("email_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions           Session[]
  verificationTokens VerificationToken[]
  memberships        WorkspaceMember[]
  invitationsSent    WorkspaceInvitation[]
  sales              Sale[]
  openedRegisters    CashRegister[]        @relation("OpenedRegisters")
  closedRegisters    CashRegister[]        @relation("ClosedRegisters")
  accountPayments    AccountPayment[]
  returns            Return[]
  pushSubscriptions  PushSubscription[]
  feedback           Feedback[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("verification_tokens")
}

// ========== SUSCRIPCIONES PUSH (PWA) ==========
model PushSubscription {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  endpoint  String  @unique
  authSecret String @map("auth_secret")
  p256dh    String
  userAgent String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Workspace {
  id   String @id @default(cuid())
  name String
  slug String @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members       WorkspaceMember[]
  products      Product[]
  suppliers     Supplier[]
  orders        PurchaseOrder[]
  alerts        Alert[]
  invitations   WorkspaceInvitation[]
  sales         Sale[]
  cashRegisters CashRegister[]
   customers     Customer[]
   feedback      Feedback[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  workspaceId String        @map("workspace_id")
  role        WorkspaceRole @default(OWNER)

  createdAt DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_members")
}

// ========== PRODUCTOS ==========
model Product {
  id           String  @id @default(cuid())
  workspaceId  String? @map("workspace_id")
  name         String
  sku          String  @unique
  description  String?
  currentStock Int     @default(0)
  minStock     Int     @default(10)
  costPrice    Decimal @map("cost_price")
  sellingPrice Decimal @map("selling_price")
  category     String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace      Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  purchaseOrders PurchaseOrderItem[]
  alerts         Alert[]
  catalogItems   CatalogItems[]

  @@index([workspaceId])
  @@map("products")
}

// ========== VENTAS ==========
model Sale {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  userId         String        @map("user_id")
  cashRegisterId String?       @map("cash_register_id")
  customerId     String?       @map("customer_id")
  receiptNumber  Int           @map("receipt_number")
  paymentMethod  PaymentMethod @map("payment_method")
  status         SaleStatus    @default(COMPLETED)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  notes          String?
  saleDate       DateTime      @map("sale_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  items        SaleItem[]
  returns      Return[]

  @@unique([workspaceId, receiptNumber])
  @@index([workspaceId, saleDate])
  @@index([userId])
  @@index([cashRegisterId])
  @@map("sales")
}

model SaleItem {
  id             String  @id @default(cuid())
  saleId         String  @map("sale_id")
  productId      String  @map("product_id")
  quantity       Int
  unitPrice      Decimal @map("unit_price") @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalPrice     Decimal @map("total_price") @db.Decimal(10, 2)

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@map("sale_items")
}

// ========== PROVEEDORES ==========
model Supplier {
  id           String  @id @default(cuid())
  workspaceId  String? @map("workspace_id")
  name         String
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  leadTime     Int     @default(7) // Días promedio de entrega
  shippingCost Decimal @default(0) @map("shipping_cost")
  reliability  Float   @default(4.5) // Rating 1-5
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  workspace      Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  catalog        CatalogItems[]
  purchaseOrders PurchaseOrder[]
  notifications  SupplierNotification[]

  @@index([workspaceId])
  @@map("suppliers")
}

// ========== CATÁLOGO DE PROVEEDORES ==========
model CatalogItems {
  id          String  @id @default(cuid())
  supplierId  String  @map("supplier_id")
  productId   String  @map("product_id")
  unitPrice   Decimal @map("unit_price") // Precio del proveedor para este producto
  minOrderQty Int     @default(1) @map("min_order_qty")

  // Relaciones
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]

  @@unique([supplierId, productId])
  @@map("catalog_items")
}

// ========== HISTORIAL DE CAMBIOS DE PRECIO ==========
model PriceHistory {
  id              String   @id @default(cuid())
  catalogItemId   String   @map("catalog_item_id")
  supplierId      String   @map("supplier_id")
  productId       String   @map("product_id")
  previousPrice   Decimal? @map("previous_price")
  newPrice        Decimal  @map("new_price")
  previousMinQty  Int?     @map("previous_min_qty")
  newMinQty       Int?     @map("new_min_qty")
  changeType      String // CREATED, UPDATED, DELETED, IMPORTED
  changedByUserId String?  @map("changed_by_user_id")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")

  catalogItem CatalogItems? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([supplierId, createdAt])
  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("price_history")
}

// ========== NOTIFICACIONES A PROVEEDORES ==========
model SupplierNotification {
  id             String    @id @default(cuid())
  supplierId     String    @map("supplier_id")
  workspaceId    String?   @map("workspace_id")
  type           String // PRICE_CHANGE, PRICE_ACCEPTED, PRICE_REJECTED
  subject        String
  message        String
  changesSummary Json?     @map("changes_summary")
  emailSentAt    DateTime? @map("email_sent_at")
  emailTo        String?   @map("email_to")

  createdAt DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, createdAt])
  @@index([workspaceId])
  @@map("supplier_notifications")
}

// ========== INVITACIONES A WORKSPACE ==========
model WorkspaceInvitation {
  id              String        @id @default(cuid())
  workspaceId     String        @map("workspace_id")
  email           String
  role            WorkspaceRole @default(MEMBER)
  token           String        @unique
  invitedByUserId String        @map("invited_by_user_id")
  status          String        @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  expiresAt       DateTime      @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUser User?     @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
  @@map("workspace_invitations")
}

// ========== CAJA REGISTRADORA ==========
model CashRegister {
  id            String             @id @default(cuid())
  workspaceId   String             @map("workspace_id")
  openedBy      String             @map("opened_by")
  closedBy      String?            @map("closed_by")
  openingAmount Decimal            @map("opening_amount") @db.Decimal(10, 2)
  closingAmount Decimal?           @map("closing_amount") @db.Decimal(10, 2)
  status        CashRegisterStatus @default(OPEN)
  expectedCash  Decimal?           @map("expected_cash") @db.Decimal(10, 2)
  difference    Decimal?           @map("difference") @db.Decimal(10, 2)
  notes         String?
  openedAt      DateTime           @default(now()) @map("opened_at")
  closedAt      DateTime?          @map("closed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  opener    User      @relation("OpenedRegisters", fields: [openedBy], references: [id])
  closer    User?     @relation("ClosedRegisters", fields: [closedBy], references: [id])
  sales     Sale[]

  @@index([workspaceId, status])
  @@index([openedBy])
  @@map("cash_registers")
}

// ========== CLIENTES ==========
model Customer {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  name        String
  email       String?
  phone       String?
  address     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  sales           Sale[]
  accountPayments AccountPayment[]

  @@index([workspaceId])
  @@map("customers")
}

// ========== CUENTA CORRIENTE ==========
model AccountPayment {
  id          String   @id @default(cuid())
  customerId  String
  workspaceId String
  userId      String?
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([workspaceId])
}

// ========== ÓRDENES DE COMPRA ==========
model PurchaseOrder {
  id            String      @id @default(cuid())
  workspaceId   String?     @map("workspace_id")
  supplierId    String      @map("supplier_id")
  status        OrderStatus @default(DRAFT)
  totalAmount   Decimal     @default(0) @map("total_amount")
  notes         String?
  generatedByAI Boolean     @default(true) @map("generated_by_ai")
  emailSentAt   DateTime?   @map("email_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  workspace Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  items     PurchaseOrderItem[]

  @@index([workspaceId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String  @map("purchase_order_id")
  productId       String  @map("product_id")
  quantity        Int
  unitPrice       Decimal @map("unit_price")
  totalPrice      Decimal @map("total_price")

  // Relaciones
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

// ========== ALERTAS ==========
model Alert {
  id          String    @id @default(cuid())
  workspaceId String?   @map("workspace_id")
  productId   String?   @map("product_id")
  type        AlertType
  title       String?
  message     String
  href        String?
  isRead      Boolean   @default(false)
  isResolved  Boolean   @default(false)
  metadata    Json? // Datos adicionales como burnRate, días hasta agotamiento, etc.

  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([productId, createdAt])
  @@map("alerts")
}

// ========== DEVOLUCIONES ==========
model Return {
  id          String   @id @default(cuid())
  saleId      String
  workspaceId String
  userId      String?
  reason      String?
  totalRefund Decimal  @db.Decimal(12, 2)
  status      String   @default("COMPLETED") // COMPLETED, PENDING
  createdAt   DateTime @default(now())

  sale  Sale         @relation(fields: [saleId], references: [id])
  items ReturnItem[]
  user  User?        @relation(fields: [userId], references: [id])

  @@index([saleId])
  @@index([workspaceId])
}

model ReturnItem {
  id         String  @id @default(cuid())
  returnId   String
  saleItemId String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)

  return   Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])

  @@index([returnId])
}

// ========== ENUMS ==========
enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ACCOUNT
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  DRAFT
  SENT
  CONFIRMED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum AlertType {
  LOW_STOCK
  CRITICAL_STOCK
  STAGNANT_STOCK
  PRICE_CHANGE
  SUPPLIER_RISK
  ORDER_STATUS
  REGISTER_DISCREPANCY
  PAYMENT_RECEIVED
  LOW_BALANCE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Feedback {
  id          String       @id @default(cuid())
  userId      String
  workspaceId String?
  type        String       @default("OTHER")
  message     String
  email       String?
  status      FeedbackStatus @default(NEW)
  adminReply  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
  CLOSED
}
